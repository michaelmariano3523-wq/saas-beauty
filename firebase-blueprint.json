{
  "entities": {
    "Shop": {
      "title": "Shop",
      "description": "A barbershop registered on the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "ownerName": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "basic", "pro", "enterprise"] },
        "status": { "type": "string", "enum": ["active", "inactive", "suspended", "trial"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "trialEndsAt": { "type": "string", "format": "date-time" },
        "subscriptionEndsAt": { "type": "string", "format": "date-time" },
        "monthlyRevenue": { "type": "number" },
        "totalBarbers": { "type": "number" },
        "totalAppointments": { "type": "number" },
        "phone": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "name", "ownerId", "plan", "status"]
    },
    "Plan": {
      "title": "Plan",
      "description": "Subscription plan definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "interval": { "type": "string", "enum": ["monthly", "yearly"] },
        "features": { "type": "array", "items": { "type": "string" } },
        "maxBarbers": { "type": "number" },
        "maxAppointments": { "type": "number" },
        "maxProducts": { "type": "number" },
        "hasAI": { "type": "boolean" },
        "hasReports": { "type": "boolean" },
        "hasInventory": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "trialDays": { "type": "number" }
      },
      "required": ["id", "name", "price", "features"]
    },
    "User": {
      "title": "User",
      "description": "A shop owner or staff member.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "barber", "receptionist", "admin"] },
        "shopId": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "Barber": {
      "title": "Barber",
      "description": "A professional barber in the shop.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "rating": { "type": "number" },
        "avatar": { "type": "string" },
        "stats": {
          "type": "object",
          "properties": {
            "monthlyCuts": { "type": "number" },
            "revenue": { "type": "number" }
          }
        }
      },
      "required": ["name", "role"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled service.",
      "type": "object",
      "properties": {
        "startTime": { "type": "string", "format": "date-time" },
        "clientName": { "type": "string" },
        "service": { "type": "string" },
        "barberId": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "pending", "cancelled", "completed"] },
        "price": { "type": "number" }
      },
      "required": ["startTime", "clientName", "barberId", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory item.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "minQuantity": { "type": "number" }
      },
      "required": ["name", "quantity"]
    },
    "Finance": {
      "title": "Finance Record",
      "description": "Revenue or expense record.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["revenue", "expense"] },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "amount", "date"]
    }
  },
  "firestore": {
    "/shops": {
      "schema": "Shop",
      "description": "Global shops collection."
    },
    "/plans": {
      "schema": "Plan",
      "description": "Subscription plans available."
    },
    "/shops/{shopId}/barbers": {
      "schema": "Barber",
      "description": "Barbers registered in a specific shop."
    },
    "/shops/{shopId}/appointments": {
      "schema": "Appointment",
      "description": "Appointments for a specific shop."
    },
    "/shops/{shopId}/inventory": {
      "schema": "Product",
      "description": "Inventory for a specific shop."
    },
    "/shops/{shopId}/finances": {
      "schema": "Finance",
      "description": "Financial records for a specific shop."
    },
    "/users": {
      "schema": "User",
      "description": "Global user profiles."
    }
  }
}

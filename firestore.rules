rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Helper for admin with exists check
    function isAdminOrReadAll() {
      return request.auth == null ? false : (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        request.auth.uid == request.resource.id
      );
    }

    // Helper function to check if user owns the shop
    function isShopOwner(shopId) {
      return request.auth != null && (
        request.auth.uid == shopId || 
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/shops/$(shopId)).data.uid == request.auth.uid
      );
    }

    // Admin has full access to everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Plans - admin can write, all authenticated can read
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Settings - admin can write, all can read
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
